//============================================================================
//  full_top 时序约束
//
//  ⚠⚠ 实测要点（new/测试清单.md）：
//    · `clk12288` 的实际频率是 **24.576 MHz**（不是 12.288）——
//      MS5351 U2(PLL1) 的 CLK2 输出，实测 ≈24.5 MHz。
//      周期必须写 40.690 ns；写 81.38 ns 会触发
//      `TA1118 clock "clk_in" frequency does not match PLL param FCLKIN`。
//    · N22 不是专用时钟脚，会走通用布线（PR1014 警告），但 PLL 仍能锁定。
//============================================================================

// ---- 板载 50 MHz（P16）：USE_PLL=0 时的主时钟 ----
create_clock -name clk50 -period 20.000 -waveform {0 10.000} [get_ports {clk50}]

// ---- MS5351M CLK2 来的 24.576 MHz（N22）：USE_PLL=1 时给 PLL 做参考 ----
//      周期 = 1/24.576MHz = 40.690 ns（与 pll_49m.v 的 FCLKIN="24.576" 对应）
create_clock -name clk12288 -period 40.690 -waveform {0 20.345} [get_ports {clk12288}]

// ---- 输出到 DAC 的三根线是低速（BCLK 1.536/1.5625 MHz），不设额外约束 ----

//============================================================================
//  以下为 **full_system**（集成顶层，上板 Top Module）新增端口的约束
//  —— 2026-10-08 poki 补
//============================================================================

// MIDI 串行输入是**外部异步信号**，midi_parse 内部每路都做了两级触发器同步。
// 必须声明 false path，否则时序分析会把它当同步路径，报一堆虚假违例。
set_false_path -from [get_ports {midi_rx[*]}]

// 慢速 GPIO：功放使能是毫秒级控制信号，不需要时序收敛
set_false_path -to [get_ports {PA_EN}]

// MS5351 的 I2C：开漏慢速总线（100 kHz），按 false path 处理
set_false_path -from [get_ports {scl}]
set_false_path -from [get_ports {sda}]

//============================================================================
//  调试 LED（2026-10-15 补）
//  dbg_led[2:0] = 泳道0 的 timbre_slot（寄存器直出）
//  dbg_led[3]   = ~(|dbg_evt_cnt) —— 22 位计数器归零比较
//  都是慢速调试信号，人为收敛输出延迟没有意义，且会白占时序余量。
//============================================================================
set_false_path -to [get_ports {dbg_led[*]}]

//============================================================================
//  2026-10-23 追加 —— LCD 输出（像素域 35 MHz，面板很宽容）
//  不设 output delay，只放开到引脚的最后一级，避免工具为收敛 IO 时序做无效布局
//============================================================================
set_false_path -to [get_ports {lcd_r[*]}]
set_false_path -to [get_ports {lcd_g[*]}]
set_false_path -to [get_ports {lcd_b[*]}]
set_false_path -to [get_ports {lcd_en}]
