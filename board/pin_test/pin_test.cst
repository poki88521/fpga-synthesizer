// [2026-10-05 22:12]  本文件时间戳（用于校验是否被外部覆盖）
//=============================================================
//  pin_test —— 物理约束（PMOD2 八脚输出已知频率）
//  板卡：Tang Mega 138K Pro (GW5AST-LV138FPG676A, FCPBG676A)
//=============================================================

// ---------- 时钟 ----------
IO_LOC "clk" P16;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------- PMOD2：J26（Conn_02x06），全部为普通 IO，bank5 ----------
IO_LOC "p0" C21;    // PMOD2_IO0  12207 Hz
IO_PORT "p0" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p1" B20;    // PMOD2_IO1   6104 Hz
IO_PORT "p1" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p2" B19;    // PMOD2_IO2   3052 Hz
IO_PORT "p2" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p3" A17;    // PMOD2_IO3   1526 Hz
IO_PORT "p3" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p4" B21;    // PMOD2_IO4    763 Hz
IO_PORT "p4" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p5" A20;    // PMOD2_IO5    381 Hz
IO_PORT "p5" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p6" A19;    // PMOD2_IO6    191 Hz
IO_PORT "p6" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p7" A18;    // PMOD2_IO7     95 Hz
IO_PORT "p7" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------- LED ----------
IO_LOC "led" M25;   // USR_LED.3
IO_PORT "led" IO_TYPE=LVCMOS33 DRIVE=8;
