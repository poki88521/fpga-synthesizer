// [2026-10-06 11:23]  本文件时间戳（用于校验是否被外部覆盖）
//=============================================================
//  pll_test —— 物理约束（T-2：MS5351 -> N22 -> PLL -> 49.152 MHz）
//  板卡：Tang Mega 138K Pro (GW5AST-LV138FPG676A, FCPBG676A)
//=============================================================

// ---------- 控制域时钟 ----------
IO_LOC "clk" P16;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------- MS5351 I2C ----------
IO_LOC "scl" K25;
IO_PORT "scl" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;

IO_LOC "sda" K26;
IO_PORT "sda" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;

// ---------- TWI 复用器（N19=SEL0, P19=SEL1, P26=SEL2） ----------
IO_LOC "mux_sel0" N19;
IO_PORT "mux_sel0" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_sel1" P19;
IO_PORT "mux_sel1" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_sel2" P26;
IO_PORT "mux_sel2" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------- N22 -> PLL CLKIN（12.288 MHz） ----------
IO_LOC "clk_in" N22;
IO_PORT "clk_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------- LED（低电平点亮） ----------
IO_LOC "led_lock" M25;   // USR_LED.3：PLL LOCK -> 亮
IO_PORT "led_lock" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_cfg" R26;    // USR_LED.1：MS5351 配置成功 -> 亮
IO_PORT "led_cfg" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_scan" L20;   // USR_LED.2：扫描中 -> 闪
IO_PORT "led_scan" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_49m" N21;    // USR_LED.4：49.152 MHz 域在跑 -> 闪
IO_PORT "led_49m" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------- PMOD2（示波器测点） ----------
IO_LOC "p_raw" C21;      // PMOD2_IO0  49.152 MHz
IO_PORT "p_raw" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p_div16" B20;    // PMOD2_IO1  3.072 MHz
IO_PORT "p_div16" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p_div256" B19;   // PMOD2_IO2  192 kHz
IO_PORT "p_div256" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p_clkin" A17;    // PMOD2_IO3  12.288 MHz (N22 直通)
IO_PORT "p_clkin" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_b0" B21;     // PMOD2_IO4
IO_PORT "mux_b0" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_b1" A20;     // PMOD2_IO5
IO_PORT "mux_b1" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_b2" A19;     // PMOD2_IO6
IO_PORT "mux_b2" IO_TYPE=LVCMOS33 DRIVE=8;
