//=============================================================
//  物理约束 - PT8211 音频测试
//  板卡：Tang Mega 138K Pro (GW5AST-LV138FPG676A, FC 封装)
//  引脚来源：material/important/UG986-1.2 Pinout
//            + TANG_MEGA-138K_Pro-Dock-4071f_Schematic
//=============================================================

// ---------- 时钟 ----------
// 50 MHz 板载有源晶振（推挽输出，不需要上拉）
// 注：官方例程用 V22；若烧录后 LED 不闪，可改试 P16（见 scratch/list.md）
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// ---------- PT8211 DAC 接口 ----------
// 走线经 BTB 到 Dock，约 3~5 cm，驱动强度提到 12
IO_LOC "bclk"  E22;                              // BANK5
IO_PORT "bclk"  IO_TYPE=LVCMOS33 DRIVE=12;

IO_LOC "lrck"  F24;                              // BANK4
IO_PORT "lrck"  IO_TYPE=LVCMOS33 DRIVE=12;

IO_LOC "din"   G24;                              // BANK4
IO_PORT "din"   IO_TYPE=LVCMOS33 DRIVE=12;

IO_LOC "pa_en" H17;                              // BANK5
IO_PORT "pa_en" IO_TYPE=LVCMOS33 DRIVE=12;

// ---------- 状态 LED ----------
// USR_LED.3 = M25（BANK3，3V3）；其余可选 L20 / N21 / N22 / R26
IO_LOC "led"   M25;
IO_PORT "led"   IO_TYPE=LVCMOS33 DRIVE=8;

// ---------- 注意事项 ----------
// 1. 不要使用 CLOCK_LOC 约束（该指令不作用于顶层输入端口，会报 CT1020）
// 2. PR1014 警告（时钟走通用布线）不影响功能，可忽略
// 3. BCLK/E22 与 H17 在 BANK5，LRCK/F24 与 DIN/G24 在 BANK4
//    需确认两个 BANK 的 VCCIO 均为 3.3V
