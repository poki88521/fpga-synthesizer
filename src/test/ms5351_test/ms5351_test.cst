// [2026-10-05 22:25]  本文件时间戳（用于校验是否被外部覆盖）
//=============================================================
//  ms5351_test —— 物理约束（方案E：配置 CLK2，观测 N22）
//  板卡：Tang Mega 138K Pro (GW5AST-LV138FPG676A, FCPBG676A)
//=============================================================

// ---------- 时钟 ----------
IO_LOC "clk" P16;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------- MS5351 I2C（IIC_SCL_MAIN / IIC_SDA_MAIN） ----------
IO_LOC "scl" K25;
IO_PORT "scl" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;

IO_LOC "sda" K26;
IO_PORT "sda" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;

// ---------- TWI 复用器（N19=SEL0, P19=SEL1, P26=SEL2） ----------
IO_LOC "mux_sel0" N19;
IO_PORT "mux_sel0" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_sel1" P19;
IO_PORT "mux_sel1" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_sel2" P26;
IO_PORT "mux_sel2" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------- USR_CLK_IN = N22（据 CLOCK 页坐标分析） ----------
IO_LOC "clk_in" N22;
IO_PORT "clk_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------- LED（低电平点亮） ----------
IO_LOC "led_ok" M25;     // USR_LED.3：至少一档成功 -> 亮
IO_PORT "led_ok" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_err" R26;    // USR_LED.1：8 档全 NACK -> 亮
IO_PORT "led_err" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_scan" L20;   // USR_LED.2：扫描中 -> 闪；结束 -> 灭
IO_PORT "led_scan" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_in" N21;     // USR_LED.4：N22 有时钟 -> 闪
IO_PORT "led_in" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------- PMOD2 调试输出 ----------
IO_LOC "dbg_a0" C21;     // PMOD2_IO0 <- N22 直通
IO_PORT "dbg_a0" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "dbg_a1" B20;     // PMOD2_IO1 <- N22 直通
IO_PORT "dbg_a1" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_b0" B19;     // PMOD2_IO2 首个成功 mux 值[0]
IO_PORT "mux_b0" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_b1" A17;     // PMOD2_IO3
IO_PORT "mux_b1" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "mux_b2" B21;     // PMOD2_IO4
IO_PORT "mux_b2" IO_TYPE=LVCMOS33 DRIVE=8;
